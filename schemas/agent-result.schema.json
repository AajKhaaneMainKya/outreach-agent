{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes result",
  "type": "object",
  "required": ["evidence_id", "claim_id", "reason", "pain_hypothesis", "qa_pass"],
  "properties": {
    "evidence_id": {"type": "string", "description": "Must resolve to actual retrieved evidence"},
    "claim_id": {"type": "string", "description": "Must resolve to a user-approved strategy claim"},
    "reason": {"type": "string", "maxLength": 1500},
    "pain_hypothesis": {"type": "string", "maxLength": 1500},
    "qa_pass": {"type": "boolean"},
    "agent_trace": {"type": "array", "items": {"type": "string"}}
  }
}
