# Demo/dashboard need only Python 3.11+; no secrets required.
PORT=8765
# Live discovery (Google Places API New, billing enabled)
GOOGLE_PLACES_API_KEY=
# Hermes source installation and its own Python environment
HERMES_SOURCE=~/.hermes/hermes-agent
HERMES_PYTHON=~/.hermes/hermes-agent/venv/bin/python
HERMES_MODEL=
# Never copy ChatGPT tokens into this file. Sign in using `hermes model`.
# Sending is OFF. Enabling this still requires approval + a separate Send click.
ALLOW_SEND=false
GMAIL_CLIENT_FILE=data/google-client.json
GMAIL_TOKEN_FILE=data/gmail-token.json

# Optional remote access: exact HTTPS hostname only; set before tunneling.
# Keep password private in ~/.config/outreach-agent/runtime.env; login username is continere.
GTM_PUBLIC_ORIGIN=
GTM_REMOTE_PASSWORD=

# Optional Apollo contacts; save actual values only in the private WSL runtime.env.
APOLLO_API_KEY=
# Agent search never enriches. CLI enrichment needs this flag and --confirm-credit-use.
ALLOW_APOLLO_ENRICHMENT=false
APOLLO_DAILY_ENRICHMENT_LIMIT=5
